---
interface Props { lang: 'es' | 'en' }
const { lang } = Astro.props;
const es = lang === 'es';
const L = {
  eyebrow: es ? 'catálogo de modelos' : 'model catalog',
  title: es ? 'Todos los modelos' : 'All models',
  sub: es ? 'Explorá todos los modelos compatibles, clasificados por nivel de recursos (S–F). Hacé clic en uno para abrir su ficha completa.' :
          'Browse all compatible models, graded by resource level (S–F). Click one to open its full card.',
  q: es ? 'Buscar modelo…' : 'Search models…',
  prev: es ? 'Anterior' : 'Previous',
  next: es ? 'Siguiente' : 'Next',
};
const base = import.meta.env.BASE_URL;
---
<section id="models" class="mx-auto max-w-6xl px-4 pt-14 pb-16 scroll-mt-20">
  <p class="mono text-xs uppercase tracking-widest text-muted text-center">{L.eyebrow}</p>
  <h1 class="mt-2 text-3xl md:text-4xl font-black tracking-tight text-center">{L.title}</h1>
  <p class="mt-3 text-center text-muted max-w-2xl mx-auto">{L.sub}</p>

  <div class="mt-6 flex flex-wrap justify-center gap-2 mono text-[11px] text-muted">
    <span><span class="g2">S</span> ≤1.5B</span>
    <span><span class="g2 gA">A</span> ≤4B</span>
    <span><span class="g2 gB">B</span> ≤8B</span>
    <span><span class="g2 gC">C</span> ≤14B</span>
    <span><span class="g2 gD">D</span> ≤32B</span>
    <span><span class="g2 gF">F</span> &gt;32B</span>
  </div>

  <div class="mt-8">
    <div class="flex flex-wrap items-center gap-2.5">
      <input data-mc-q class="mc-input" type="search" placeholder={L.q} aria-label={L.q} />
      <span data-mc-status class="mono text-xs text-muted ml-auto"></span>
    </div>
    <div data-mc-families class="mt-3 flex flex-wrap gap-2"></div>

    <div class="mt-6 flex items-stretch gap-3">
      <button data-mc-prev class="mc-arrow" aria-label={L.prev}>‹</button>
      <div class="flex-1 min-w-0">
        <div data-mc-list class="grid grid-cols-1 lg:grid-cols-2 gap-2.5"></div>
        <div data-mc-empty class="mt-4 hidden text-center text-muted text-sm"></div>
      </div>
      <button data-mc-next class="mc-arrow" aria-label={L.next}>›</button>
    </div>
    <div class="mt-4 text-center">
      <span data-mc-page class="mono text-xs text-muted"></span>
    </div>
  </div>
</section>

<style is:global>
  .mc-input { flex: 1 1 16rem; max-width: 26rem; background: var(--color-bg-soft); color: var(--color-ink); border: 1px solid var(--color-line); border-radius: .5rem; padding: .55rem .8rem; font-size: .875rem; }
  .mc-input:focus { outline: 2px solid var(--color-accent); outline-offset: 1px; }
  .mc-chip { font-size: .75rem; padding: .3rem .7rem; border-radius: 99px; border: 1px solid var(--color-line); color: var(--color-muted); background: transparent; cursor: pointer; transition: color .15s, border-color .15s, background .15s; }
  .mc-chip:hover { color: var(--color-ink); border-color: var(--color-accent); }
  .mc-chip.on { color: var(--color-accent); border-color: var(--color-accent); background: color-mix(in srgb, var(--color-accent) 12%, transparent); }
  .mc-arrow { flex: none; width: 2.75rem; border: 1px solid transparent; border-radius: .75rem; background: transparent; color: var(--color-muted); font-size: 1.4rem; line-height: 1; cursor: pointer; transition: color .15s, border-color .15s, box-shadow .15s; display: flex; align-items: center; justify-content: center; }
  .mc-arrow:hover:not(:disabled) { color: var(--color-accent); border-color: color-mix(in srgb, var(--color-accent) 60%, transparent); box-shadow: 0 0 12px color-mix(in srgb, var(--color-accent) 45%, transparent); }
  .mc-arrow:disabled { opacity: .3; cursor: default; }
  .mc-row { display: flex; align-items: center; gap: .8rem; padding: .7rem .9rem; border: 1px solid var(--color-line); border-radius: .8rem; background: var(--color-panel); transition: border-color .15s, background .15s, transform .15s; }
  .mc-row:hover { border-color: color-mix(in srgb, var(--color-accent) 60%, var(--color-line)); background: color-mix(in srgb, var(--color-accent) 6%, var(--color-panel)); transform: translateY(-1px); }
  .mc-mid { display: flex; flex-direction: column; min-width: 0; }
  .mc-name { font-family: var(--font-mono); font-weight: 600; font-size: .875rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mc-sub { font-family: var(--font-mono); font-size: .72rem; color: var(--color-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mc-right { margin-left: auto; display: flex; align-items: center; gap: .5rem; flex: none; }
  .mc-size { font-family: var(--font-mono); font-size: .72rem; color: var(--color-muted); }
  .mc-go { color: var(--color-accent); font-weight: 700; }
  .g2 { display: inline-grid; place-items: center; width: 1.15rem; height: 1.15rem; border-radius: 6px; background: #22c55e; color: #0a0a0a; font-weight: 800; font-size: .7rem; margin-right: .2rem; }
  .g2.gA { background: #4ade80; } .g2.gB { background: #a3e635; } .g2.gC { background: #f59e0b; } .g2.gD { background: #f97316; } .g2.gF { background: #ef4444; }
</style>

<script>
  import { mountCatalog } from '../lib/model-catalog.js';
  void mountCatalog(document.documentElement.lang.startsWith('es') ? 'es' : 'en');
</script>