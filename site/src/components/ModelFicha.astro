---
import { requiredHardware } from '../lib/compat.js';
import type { ModelEntry } from '../lib/models.js';
interface Props { model: ModelEntry; lang: 'es' | 'en' }
const { model, lang } = Astro.props;
const es = lang === 'es';
const L = {
  back: es ? '← Volver' : '← Back',
  eyebrow: es ? 'Ficha de modelo' : 'Model card',
  tags: es ? 'Especificaciones' : 'Specifications',
  capac: es ? 'Capacidad y aplicaciones' : 'Capabilities & use cases',
  req: es ? 'Requisitos y mejoras' : 'Requirements & upgrades',
  instalar: es ? 'Instalación' : 'Install',
  parametros: es ? 'Parámetros' : 'Parameters',
  contexto: es ? 'Contexto' : 'Context',
  herramientas: es ? 'Herramientas' : 'Tools',
  razonamiento: es ? 'Razonamiento' : 'Reasoning',
  licencia: es ? 'Licencia' : 'License',
  tamano: es ? 'Tamaño' : 'Size',
  si: es ? 'Sí' : 'Yes',
  no: es ? 'No' : 'No',
  vram: 'VRAM',
  gpuRec: es ? 'GPU recomendada' : 'Recommended GPU',
  ram: es ? 'RAM total' : 'Total RAM',
  bw: es ? 'Ancho de banda' : 'Bandwidth',
  disco: es ? 'Disco' : 'Disk',
  equipo: es ? 'Tu equipo en vivo' : 'Your device, live',
  deteccion: es ? 'detección real en tu navegador' : 'real detection in your browser',
  analizando: es ? 'Analizando tu equipo…' : 'Analyzing your device…',
  casos: es ? 'Casos de uso' : 'Use cases',
  sinCases: es ? 'Modelo generalista que sirve para chat, código y automatizaciones ligeras.' : 'General-purpose model for chat, code and light automation.',
  nota: es ? 'Nota de mejora' : 'Upgrade note',
  notaCpu: es ? 'Este modelo es liviano: corre bien en CPU. Para ir más rápido puedes usar una GPU con al menos #VRAM GB de VRAM.' : 'Lightweight model: runs fine on CPU. For more speed, a GPU with at least #VRAM GB of VRAM helps.',
  notaGpu: es ? 'Para despegar de verdad, usa una GPU dedicada con al menos #VRAM GB de VRAM (Q4_K_M).' : 'To really fly, use a dedicated GPU with at least #VRAM GB of VRAM (Q4_K_M).',
  comando: es ? 'Descargá y serví el modelo con un solo comando:' : 'Download and serve the model with one command:',
  comfy: es ? 'Generación con ComfyUI: descarga los pesos y cargá el workflow.' : 'ComfyUI generation: download the weights and load the workflow.',
  instalarEn: es ? 'Servirlo con RANDI' : 'Serve it with RANDI',
};
const req = requiredHardware(model.paramsBillions || 0);
const gpuVram = Math.round(req.gpuVramRec);
const spec: Array<[string, string]> = [
  [L.parametros, `${model.paramsBillions}B`],
  [L.contexto, model.ctx ? `${model.ctx >= 1000 ? (model.ctx / 1000).toFixed(0) + 'K' : model.ctx}` : '—'],
  [L.herramientas, model.tools ? L.si : L.no],
  [L.razonamiento, model.thinking ? L.si : L.no],
  [L.licencia, model.license || '—'],
  [L.tamano, model.size || '—'],
];
const reqSpec: Array<[string, string]> = [
  [L.vram, `${req.vramGB} GB (${req.quant})`],
  [L.gpuRec, req.gpuClass],
  [L.ram, `${req.ramTotal} GB`],
  [L.bw, `${req.bandwidth} GB/s`],
  [L.disco, `${req.diskGB} GB`],
];
const nota = (model.paramsBillions || 0) <= 3
  ? L.notaCpu.replace('#VRAM', String(gpuVram))
  : L.notaGpu.replace('#VRAM', String(gpuVram));
const base = import.meta.env.BASE_URL;
const cases = model.useCase && model.useCase.length ? model.useCase : [];
---
<div class="mx-auto max-w-4xl px-4 py-10">
  <a href={es ? base : `${base}en/`} class="text-sm text-muted hover:text-ink inline-flex items-center gap-1">{L.back}</a>

  <p class="eyebrow mt-8">{L.eyebrow}</p>
  <h1 class="mt-2 text-4xl font-black tracking-tight">{model.name}</h1>
  <p class="mt-1 text-muted">{model.provider} · {model.family}</p>
  <div class="mt-3 flex flex-wrap gap-2">
    <span class="pill">#{model.paramsBillions}B</span>
    <span class="pill">{model.architecture}</span>
    {cases.slice(0, 3).map((uc) => <span class="pill muted-pill">{uc}</span>)}
    {model.thinking && <span class="pill" style="border-color:var(--color-accent);color:var(--color-accent)">{es ? 'razonamiento' : 'reasoning'}</span>}
    {model.tools && <span class="pill">{L.herramientas}</span>}
  </div>
  {model.desc && <p class="mt-4 text-muted leading-relaxed max-w-2xl">{model.desc}</p>}

  <nav class="mf-tabs" role="tablist" aria-label="Sections">
    <button type="button" class="mf-tab on" data-tab="spec">{L.tags}</button>
    <button type="button" class="mf-tab" data-tab="capaz">{L.capac}</button>
    <button type="button" class="mf-tab" data-tab="req">{L.req}</button>
    <button type="button" class="mf-tab" data-tab="instalar">{L.instalar}</button>
  </nav>

  <!-- Especificaciones -->
  <section class="card p-6 mf-panel on" data-panel="spec">
    <h2 class="font-bold text-lg">{L.tags}</h2>
    <dl class="mf-dl">
      {spec.map(([k, v]) => (
        <div class="mf-row"><dt class="text-muted">{k}</dt><dd class="mono">{v}</dd></div>
      ))}
    </dl>
    <div class="mt-6 pt-4 border-t border-line/40">
      <h3 class="font-semibold text-sm text-muted">{L.equipo} <span class="mono text-xs">({L.deteccion})</span></h3>
      <div id="ficha-badge" data-params={model.paramsBillions || 1} data-lang={lang} class="mt-2 text-sm text-muted">{L.analizando}</div>
    </div>
  </section>

  <!-- Capacidad y aplicaciones -->
  <section class="card p-6 mf-panel" data-panel="capaz">
    <h2 class="font-bold text-lg">{L.capac}</h2>
    <p class="mt-3 leading-relaxed text-muted">{model.desc || model.category || model.type}</p>
    {cases.length > 0 && (
      <div class="mt-6">
        <h3 class="font-semibold text-sm text-muted">{L.casos}</h3>
        <ul class="mt-3 grid sm:grid-cols-2 gap-2.5">
          {cases.map((uc) => <li class="mf-use"><span class="dot" />{uc}</li>)}
        </ul>
      </div>
    )}
  </section>

  <!-- Requisitos y mejoras -->
  <section class="card p-6 mf-panel" data-panel="req">
    <h2 class="font-bold text-lg">{L.req}</h2>
    <dl class="mf-dl">
      {reqSpec.map(([k, v]) => (
        <div class="mf-row"><dt class="text-muted">{k}</dt><dd class="mono">{v}</dd></div>
      ))}
    </dl>
    <div class="mf-note">
      <h3 class="font-semibold text-sm text-muted">{L.nota}</h3>
      <p class="mt-1 text-sm leading-relaxed">{nota}</p>
    </div>
  </section>

  <!-- Instalación -->
  <section class="card p-6 mf-panel" data-panel="instalar">
    <h2 class="font-bold text-lg">{L.instalar}</h2>
    <h3 class="mt-3 font-semibold text-sm text-muted">{L.instalarEn}</h3>
    {model.installer === 'ollama' ? (
      <>
        <p class="mt-1 text-sm text-muted">{L.comando}</p>
        <code class="block mt-2">{`randi install ${model.ollamaId || model.id}`}</code>
      </>
    ) : (
      <p class="mt-3 text-sm text-muted">{L.comfy}</p>
    )}
  </section>
</div>

<style>
  .mf-tabs { margin-top: 2rem; display: flex; gap: .75rem; border-bottom: 1px solid var(--color-line); overflow-x: auto; }
  .mf-tab {
    font-size: .875rem; font-weight: 600; white-space: nowrap;
    padding: .5rem .25rem 0.625rem; margin-bottom: -1px;
    border-bottom: 2px solid transparent; color: var(--color-muted);
    background: none; cursor: pointer; transition: color .15s, border-color .15s;
  }
  .mf-tab:hover { color: var(--color-ink); }
  .mf-tab.on { border-color: var(--color-accent); color: var(--color-ink); }
  @media (min-width: 768px) {
    .mf-panel { display: none; }
    .mf-panel.on { display: block; }
  }
  .mf-row {
    display: flex; justify-content: space-between; gap: 1rem;
    border-bottom: 1px solid var(--color-line); padding: .625rem 0; font-size: .875rem;
  }
  .mf-row dt { color: var(--color-muted); }
  .mf-row dd { font-family: var(--font-mono); font-weight: 600; text-align: right; }
  .mf-use {
    display: flex; align-items: center; gap: .5rem; padding: .5rem .75rem;
    border: 1px solid var(--color-line); border-radius: .5rem; font-size: .875rem;
    background: color-mix(in srgb, var(--color-line) 10%, transparent);
  }
  .dot {
    flex: none; width: .375rem; height: .375rem; border-radius: 99px; background: var(--color-accent);
    box-shadow: 0 0 6px color-mix(in srgb, var(--color-accent) 70%, transparent);
  }
  .mf-note { margin-top: 1.25rem; padding: .875rem; border: 1px solid var(--color-line); border-radius: .5rem; background: color-mix(in srgb, var(--color-line) 10%, transparent); }
  .muted-pill { opacity: .8; }
</style>

<script>
  import { detectHardware } from '../lib/detect.js';
  import { gradeFor, gradeColor } from '../lib/compat.js';

  const mq = window.matchMedia('(min-width: 768px)');
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.mf-tab'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.mf-panel'));
  function activate(tab: HTMLButtonElement): void {
    const id = tab.dataset.tab;
    tabs.forEach((t) => t.classList.toggle('on', t === tab));
    panels.forEach((p) => p.classList.toggle('on', p.dataset.panel === id));
  }
  if (mq.matches) {
    tabs.forEach((t) => t.addEventListener('click', () => activate(t)));
  } else {
    tabs.forEach((t) => t.classList.add('on'));
  }
  mq.addEventListener('change', (e) => {
    if (e.matches) {
      const current = tabs.find((t) => t.classList.contains('on')) || tabs[0];
      activate(current);
    } else {
      tabs.forEach((t) => t.classList.add('on'));
      panels.forEach((p) => p.classList.add('on'));
    }
  });

  const card = document.getElementById('ficha-badge') as HTMLElement;
  const params = parseFloat(card?.dataset?.params || '1');
  const isEs = card?.dataset?.lang === 'es';
  detectHardware().then((hw) => {
    const ev = gradeFor(hw, params);
    const msg = ev.status === 'cannot-run'
      ? (isEs ? `No corre en tu equipo (grado ${ev.grade}) — revisa «Requisitos»`
              : `Does not run on your device (grade ${ev.grade}) — see "Requirements"`)
      : (isEs ? `Grado ${ev.grade} · ${ev.quant} · ≈${ev.toksPerSec} tok/s (corre cómodo)`
              : `Grade ${ev.grade} · ${ev.quant} · ≈${ev.toksPerSec} tok/s`);
    card.innerHTML = `<span class="grade" style="--grade-color:${gradeColor(ev.grade)}">${ev.grade}</span> <span>${msg}</span>`;
  }).catch(() => { card.textContent = '—'; });
</script>