---
import { networks, categoriaLabelEs, categoriaLabelEn, type NetworkCategory } from '../lib/networks.js';
interface Props { lang: 'es' | 'en' }
const { lang } = Astro.props;
const es = lang === 'es';
const lab = es ? categoriaLabelEs : categoriaLabelEn;
const base = import.meta.env.BASE_URL;
const WHATSAPP = 'https://wa.me/573106197255';
const L = {
  eyebrow: es ? 'redes neuronales a medida' : 'custom neural networks',
  title: es ? 'Redes neuronales a medida' : 'Custom neural networks on demand',
  sub: es ? 'Entrenadas específicamente para tu tarea. Acá se muestran ejemplos públicos; la versión completa se vende con cotización, instalación y mantenimiento.' :
          'Trained specifically for your task. Public examples live here; the full version is sold with a quote, installation and maintenance.',
  cats: es ? 'Categorías' : 'Categories',
  all: es ? 'Todas' : 'All',
  ejemplo: es ? 'Ejemplo público' : 'Public example',
  solicitar: es ? 'Solicitar esta red' : 'Request this network',
  general: es ? 'Solicitar una red a medida' : 'Request a custom network',
  procesoT: es ? '¿Cómo funciona?' : 'How it works?',
  proceso: es ? 'cotización → producción → instalación + mantenimiento' : 'quote → production → installation + maintenance',
  paso: es ? 'Contanos qué necesitás, te cotizamos y la desarrollamos para tu caso.' : 'Tell us what you need, we quote it and build it for your case.',
  stock: es ? 'Solo se exponen ejemplos; la versión completa se vende por cliente.' : 'Only examples are shown; the full version is sold per client.',
};
const cats: NetworkCategory[] = ['imagen', 'documentos', 'cad', 'codigo', 'educacion', 'otros'];
const wa = (txt: string) => `${WHATSAPP}?text=${encodeURIComponent(txt)}`;
---
<section class="mx-auto max-w-6xl px-4 pt-14 pb-16">
  <p class="mono text-xs uppercase tracking-widest text-muted text-center">{L.eyebrow}</p>
  <h1 class="mt-2 text-center text-4xl md:text-5xl font-black tracking-tight">{L.title}</h1>
  <p class="mx-auto mt-3 max-w-2xl text-center text-muted leading-relaxed">{L.sub}</p>

  <div class="mt-8 text-center">
    <a href={wa(L.paso + '')} class="btn btn-primary">{L.general} →</a>
  </div>

  <div class="mt-10">
    <p class="mono text-xs uppercase tracking-widest text-muted text-center">{L.cats}</p>
    <div class="mt-3 flex flex-wrap justify-center gap-2">
      <button type="button" class="net-chip on" data-net-cat="">{L.all}</button>
      {cats.filter((c) => networks.some((n) => n.categoria === c)).map((c) => (
        <button type="button" class="net-chip" data-net-cat={c}>{lab[c]}</button>
      ))}
    </div>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-net-list>
      {networks.map((n) => (
        <div class="card p-5 flex flex-col gap-3" data-net-card={n.categoria}>
          <div class="flex items-center justify-between gap-2 flex-wrap">
            <span class="pill" style="border-color:var(--color-accent);color:var(--color-accent)">{lab[n.categoria]}</span>
            <span class="mono text-[10px] text-muted">{L.ejemplo}</span>
          </div>
          <h2 class="text-lg font-bold">{n.nombre}</h2>
          <p class="text-sm text-muted leading-relaxed flex-1">{n.desc}</p>
          <div class="flex gap-1.5 flex-wrap">
            {n.tags.map((t) => <span class="mono text-[10px] text-muted border border-line rounded-full px-2 py-0.5">{t}</span>)}
          </div>
          <a href={wa(`${es ? 'Hola, quiero la red «' : 'Hi, I want the network "'}${n.nombre}${es ? '» por favor.' : '" please.'}`)} class="btn btn-dark justify-center text-xs !py-2">{L.solicitar}</a>
        </div>
      ))}
    </div>
  </div>

  <div class="mt-12 mx-auto max-w-2xl card p-6 text-center">
    <p class="mono text-xs uppercase tracking-widest text-muted">{L.procesoT}</p>
    <p class="mt-3 text-muted text-sm leading-relaxed">{L.paso}</p>
    <p class="mt-2 text-xs text-muted">{L.stock}</p>
    <div class="mt-4 flex justify-center gap-2 flex-wrap">
      <code class="block max-w-full overflow-x-auto">{L.proceso}</code>
    </div>
  </div>
</section>

<style>
  .net-chip {
    font-size: .78rem; padding: .32rem .8rem; border-radius: 99px;
    border: 1px solid var(--color-line); color: var(--color-muted);
    background: transparent; cursor: pointer; transition: color .15s, border-color .15s, background .15s;
  }
  .net-chip:hover { color: var(--color-ink); border-color: var(--color-accent); }
  .net-chip.on { color: var(--color-accent); border-color: var(--color-accent); background: color-mix(in srgb, var(--color-accent) 12%, transparent); }
</style>

<script>
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.net-chip'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-net-card]'));
  const show = (cat: string) => {
    chips.forEach((c) => c.classList.toggle('on', c.dataset.netCat === cat));
    cards.forEach((c) => { c.hidden = cat ? c.dataset.netCard !== cat : false; });
  };
  chips.forEach((ch) => ch.addEventListener('click', () => show(ch.dataset.netCat || '')));
  show('');
</script>