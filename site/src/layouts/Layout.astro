---
import '../styles/global.css';
import { content } from '../i18n.js';
interface Props { lang?: 'es' | 'en'; title: string; description: string }
const { lang = 'es', title, description } = Astro.props;
const t = content[lang];
const base = import.meta.env.BASE_URL;
const canonical = lang === 'es' ? Astro.site : new URL('en/', Astro.site!);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'RANDI',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Android, Linux, macOS, Windows, WSL2',
  description: 'Asistente de IA 100% local multiplataforma para Termux, Linux, macOS y Windows. Detecta hardware y ejecuta modelos de texto, imagen y video.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: 'Sebastian Laguna' },
  url: Astro.site?.href,
};
---
<!doctype html>
<html lang={lang === 'es' ? 'es' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="es" href={Astro.site?.href} />
    <link rel="alternate" hreflang="en" href={new URL('en/', Astro.site!).href} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=Noto+Serif+Greek:wght@600;700;800&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <canvas id="bgCanvas" class="bg-canvas" aria-hidden="true"></canvas>
    <header class="sticky top-0 z-40 glass">
      <div class="mx-auto flex max-w-6xl items-center gap-2 px-3 h-12 md:h-14 md:px-4 md:gap-4">
        <a href={lang === 'es' ? base : `${base}en/`} class="flex items-center gap-2 font-bold tracking-tight text-sm md:text-base">
          <span class="greek-glyph nav">Ρ</span>
          <span>RANDI</span>
        </a>
        <nav class="hidden md:flex items-center gap-4 text-sm text-muted">
          <a href={lang === 'es' ? `${base}chat/` : `${base}en/chat/`} class="btn btn-primary text-xs !px-3.5 !py-1.5 font-semibold">{t.nav.chat}</a>
          <a href={lang === 'es' ? `${base}workspace/` : `${base}en/workspace/`} class="hover:text-ink transition-colors">{t.nav.workspace}</a>
          <a href={lang === 'es' ? `${base}docs/` : `${base}en/docs/`} class="hover:text-ink transition-colors">{t.nav.docs}</a>
          <a href={lang === 'es' ? `${base}agentes/` : `${base}en/agentes/`} class="hover:text-ink transition-colors">{t.nav.marketplace}</a>
        </nav>
        <div class="ml-auto flex items-center gap-2 md:gap-3 text-sm">
          <a href={lang === 'es' ? `${base}donar/` : `${base}en/donar/`} class="btn btn-dark text-xs !px-2.5 !py-1.5 md:!px-3 inline-flex items-center justify-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-6.7-4.3-9.3-8.6C.6 9.1 2.4 5 6.2 5c2.2 0 3.5 1.2 4.3 2.4.3.5 1 .5 1.3 0C12.6 6.2 13.9 5 16.1 5c3.8 0 5.6 4.1 3.2 7.4C16.7 16.7 12 21 12 21z"/></svg>
            <span class="hidden md:inline">{t.nav.donar}</span>
          </a>
          <a href="https://github.com/sebastianl1" target="_blank" rel="noreferrer" aria-label="GitHub" class="inline-flex h-8 w-8 md:h-9 md:w-9 items-center justify-center rounded-lg border border-line hover:border-accent transition-colors">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          </a>
          <a href={lang === 'es' ? `${base}en/` : base} class="pill hover:text-ink text-[11px] px-2 py-1 md:text-sm md:px-3 md:py-1.5">{lang === 'es' ? 'EN' : 'ES'}</a>
          <button id="menuBtn" class="md:hidden inline-flex h-8 w-8 items-center justify-center rounded-lg border border-line" aria-label="Menú">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
        </div>
      </div>
      <div id="mobileMenu" class="md:hidden glass border-t border-line">
        <div class="mx-auto max-w-6xl px-4 py-2 flex flex-col gap-1 text-sm">
          <a href={lang === 'es' ? `${base}chat/` : `${base}en/chat/`} class="py-2 font-semibold" style="color:var(--color-accent)">{t.nav.chat}</a>
          <a href={lang === 'es' ? `${base}workspace/` : `${base}en/workspace/`} class="py-2 hover:text-ink">{t.nav.workspace}</a>
          <a href={lang === 'es' ? `${base}docs/` : `${base}en/docs/`} class="py-2 hover:text-ink">{t.nav.docs}</a>
          <a href={lang === 'es' ? `${base}agentes/` : `${base}en/agentes/`} class="py-2 hover:text-ink">{t.nav.marketplace}</a>
          <a href={lang === 'es' ? `${base}donar/` : `${base}en/donar/`} class="py-2 hover:text-ink">{t.nav.donar}</a>
          <a href="#arch" class="py-2 hover:text-ink">{lang === 'es' ? 'En qué consiste' : 'About'}</a>
          <a href="#modes" class="py-2 hover:text-ink">{lang === 'es' ? 'Modos' : 'Modes'}</a>
          <a href="#install" class="py-2 hover:text-ink">{t.nav.install}</a>
          <a href="#faq" class="py-2 hover:text-ink">FAQ</a>
          <a href={lang === 'es' ? `${base}en/` : base} class="py-2 hover:text-ink">{lang === 'es' ? 'English' : 'Español'}</a>
        </div>
      </div>
    </header>
    <script is:inline>
      const mb = document.getElementById('menuBtn');
      const mm = document.getElementById('mobileMenu');
      mb?.addEventListener('click', () => mm?.classList.toggle('open'));
    </script>
    <main>
      <slot />
    </main>
    <footer class="border-t border-line mt-16" style="border-top-color:color-mix(in srgb,var(--color-accent) 30%, var(--color-line))">
      <div class="mx-auto max-w-6xl px-4 py-12">
        <div class="grid gap-10 md:grid-cols-4">
          <div>
            <a href={lang === 'es' ? base : `${base}en/`} class="flex items-center gap-2 font-bold text-lg"><span class="greek-glyph nav">Ρ</span> RANDI</a>
            <p class="mt-3 text-[11px] leading-relaxed text-muted max-w-55">{lang === 'es' ? 'RANDI Workspace: tu espacio de trabajo con IA en el centro, online u offline, abierto y trazable.' : 'RANDI Workspace: your AI-first workspace, online or offline, open and traceable.'}</p>
            <div class="mt-4 flex gap-2">
              <a href="https://github.com/sebastianl1" target="_blank" rel="noreferrer" aria-label="GitHub" class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-line hover:border-accent transition-colors"><svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg></a>
              <a href="https://wa.me/573106197255" target="_blank" rel="noreferrer" aria-label="WhatsApp" class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-line hover:border-accent transition-colors"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.5 8.5 0 0 1-12.4 7.5L3 21l2-5.6A8.5 8.5 0 1 1 21 11.5z"/></svg></a>
              <a href="https://www.linkedin.com/in/juan-sebastian-laguna-bele%C3%B1o-925345160" target="_blank" rel="noreferrer" aria-label="LinkedIn" class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-line hover:border-accent transition-colors"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5 2.5 2.5 0 0 0 4.98 3.5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.06 3.77-2.06 4.03 0 4.38 2.5 4.38 5.76V21h-4v-5.5c0-1.31-.02-3-1.86-3-1.86 0-2.15 1.45-2.15 2.95V21H9z"/></svg></a>
              <a href="mailto:sebasbele11@gmail.com" aria-label="Correo" class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-line hover:border-accent transition-colors"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="m3 6 9 7 9-7"/></svg></a>
            </div>
          </div>
          <div>
            <p class="eyebrow">{lang === 'es' ? 'Recursos' : 'Resources'}</p>
            <ul class="mt-2.5 space-y-1.5 text-[11px] text-muted">
              <li><a href={lang === 'es' ? `${base}chat/` : `${base}en/chat/`} class="hover:text-ink">{t.nav.chat}</a></li>
              <li><a href={lang === 'es' ? `${base}docs/` : `${base}en/docs/`} class="hover:text-ink">{t.nav.docs}</a></li>
              <li><a href={lang === 'es' ? `${base}agentes/` : `${base}en/agentes/`} class="hover:text-ink">{t.nav.marketplace}</a></li>
              <li><a href={lang === 'es' ? `${base}workspace/` : `${base}en/workspace/`} class="hover:text-ink">{t.nav.workspace}</a></li>
                            <li><a href={lang === 'es' ? `${base}donar/` : `${base}en/donar/`} class="hover:text-ink">{t.nav.donar}</a></li>
              <li><a href="#install" class="hover:text-ink">{t.nav.install}</a></li>
              <li><a href="#modes" class="hover:text-ink">{lang === 'es' ? 'Modos' : 'Modes'}</a></li>
              <li><a href="#traza" class="hover:text-ink">{lang === 'es' ? 'Trazabilidad' : 'Traceability'}</a></li>
              <li><a href="#faq" class="hover:text-ink">FAQ</a></li>
            </ul>
          </div>
          <div>
            <p class="eyebrow">{lang === 'es' ? 'Portafolio' : 'Portfolio'}</p>
            <a href="https://sebastianl1.github.io/Portafolio/" target="_blank" rel="noreferrer" class="mt-2.5 flex items-center gap-2 text-[11px] text-muted hover:text-ink">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7a3 3 0 0 0-6 0v7a3 3 0 0 1-6 0V6a4 4 0 0 1 8 0v7a5 5 0 0 1-10 0V6"/></svg>
              sebastianl1.github.io/Portafolio
            </a>
          </div>
          <div>
            <p class="eyebrow">{lang === 'es' ? 'Contacto' : 'Contact'}</p>
            <div class="mt-2.5 flex flex-col gap-1.5 text-[11px] text-muted">
              <a href="mailto:sebasbele11@gmail.com" class="flex items-center gap-2 hover:text-ink"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="m3 6 9 7 9-7"/></svg> sebasbele11@gmail.com</a>
              <a href="https://wa.me/573106197255" target="_blank" rel="noreferrer" class="flex items-center gap-2 hover:text-ink"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.5 8.5 0 0 1-12.4 7.5L3 21l2-5.6A8.5 8.5 0 1 1 21 11.5z"/></svg> WhatsApp</a>
              <a href="https://www.linkedin.com/in/juan-sebastian-laguna-bele%C3%B1o-925345160" target="_blank" rel="noreferrer" class="flex items-center gap-2 hover:text-ink"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5 2.5 2.5 0 0 0 4.98 3.5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.06 3.77-2.06 4.03 0 4.38 2.5 4.38 5.76V21h-4v-5.5c0-1.31-.02-3-1.86-3-1.86 0-2.15 1.45-2.15 2.95V21H9z"/></svg> LinkedIn</a>
            </div>
          </div>
        </div>
        <div class="hairline my-6"></div>
        <div class="flex flex-wrap items-center justify-between gap-2 text-[11px] text-muted">
          <span>{t.footer}</span>
          <span class="mono text-[11px]">v2.1.0</span>
        </div>
      </div>
    </footer>
  <script>
      import { initGalaxy } from '../components/hero/particles';
      const bg = document.getElementById('bgCanvas');
      if (bg) initGalaxy(bg as HTMLCanvasElement);
    </script>
  </body>
</html>