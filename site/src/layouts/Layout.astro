---
import '../styles/global.css';
import { content } from '../i18n.js';
interface Props { lang?: 'es' | 'en'; title: string; description: string }
const { lang = 'es', title, description } = Astro.props;
const t = content[lang];
const base = import.meta.env.BASE_URL;
const canonical = lang === 'es' ? Astro.site : new URL('en/', Astro.site!);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'RANDI',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Android, Linux, macOS, Windows, WSL2',
  description: 'Asistente de IA 100% local multiplataforma para Termux, Linux, macOS y Windows. Detecta hardware y ejecuta modelos de texto, imagen y video.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: 'Sebastian Laguna' },
  url: Astro.site?.href,
};
---
<!doctype html>
<html lang={lang === 'es' ? 'es' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="es" href={Astro.site?.href} />
    <link rel="alternate" hreflang="en" href={new URL('en/', Astro.site!).href} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center gap-6 px-4 h-14">
        <a href={lang === 'es' ? base : `${base}en/`} class="flex items-center gap-2 font-bold tracking-tight">
          <span class="inline-flex h-7 w-7 items-center justify-center rounded-lg" style="color:var(--color-accent);border:1px solid var(--color-line)">Ρ</span>
          <span>RANDI</span>
        </a>
        <nav class="hidden sm:flex items-center gap-5 text-sm text-muted">
          <a href={lang === 'es' ? '#arch' : `${base}en/#arch`} class="hover:text-ink transition-colors">{lang === 'es' ? 'En qué consiste' : 'About'}</a>
          <a href="#modes" class="hover:text-ink transition-colors">{lang === 'es' ? 'Modos' : 'Modes'}</a>
          <a href="#install" class="hover:text-ink transition-colors">{t.nav.install}</a>
          <a href="#faq" class="hover:text-ink transition-colors">FAQ</a>
        </nav>
        <div class="ml-auto flex items-center gap-3 text-sm">
          <a href={lang === 'es' ? `${base}en/` : base} class="pill hover:text-ink">{lang === 'es' ? 'EN' : 'ES'}</a>
          <a href="https://github.com/sebastianl1/randi_IA" target="_blank" rel="noreferrer" class="hover:text-ink">{t.nav.github} ↗</a>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="border-t border-line mt-16">
      <div class="mx-auto max-w-6xl px-4 py-12">
        <div class="grid gap-8 md:grid-cols-4">
          <div>
            <div class="flex items-center gap-2 font-bold"><span class="inline-flex h-7 w-7 items-center justify-center rounded-lg" style="color:var(--color-accent);border:1px solid var(--color-line)">Ρ</span> RANDI</div>
            <p class="mt-3 text-xs text-muted">{lang === 'es' ? 'IA local multiplataforma, trazable y abierta.' : 'Multi-platform, traceable, open local AI.'}</p>
          </div>
          <div>
            <p class="eyebrow">{lang === 'es' ? 'Portafolio' : 'Portfolio'}</p>
            <a href="https://sebastianl1.github.io/Portafolio/" target="_blank" rel="noreferrer" class="mt-3 flex items-center gap-2 text-sm text-muted hover:text-ink">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7a3 3 0 0 0-6 0v7a3 3 0 0 1-6 0V6a4 4 0 0 1 8 0v7a5 5 0 0 1-10 0V6"/></svg>
              sebastianl1.github.io/Portafolio
            </a>
          </div>
          <div>
            <p class="eyebrow">{lang === 'es' ? 'Contacto' : 'Contact'}</p>
            <div class="mt-3 flex flex-col gap-2 text-sm text-muted">
              <a href="https://wa.me/573106197255" target="_blank" rel="noreferrer" class="flex items-center gap-2 hover:text-ink">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.5 8.5 0 0 1-12.4 7.5L3 21l2-5.6A8.5 8.5 0 1 1 21 11.5z"/></svg> WhatsApp
              </a>
              <a href="mailto:sebasbele11@gmail.com" class="flex items-center gap-2 hover:text-ink">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="m3 6 9 7 9-7"/></svg> sebasbele11@gmail.com
              </a>
              <a href="https://www.linkedin.com/in/juan-sebastian-laguna-bele%C3%B1o-925345160" target="_blank" rel="noreferrer" class="flex items-center gap-2 hover:text-ink">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5 2.5 2.5 0 0 0 4.98 3.5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.06 3.77-2.06 4.03 0 4.38 2.5 4.38 5.76V21h-4v-5.5c0-1.31-.02-3-1.86-3-1.86 0-2.15 1.45-2.15 2.95V21H9z"/></svg> LinkedIn
              </a>
            </div>
          </div>
          <div>
            <p class="eyebrow">{lang === 'es' ? 'Código' : 'Code'}</p>
            <a href="https://github.com/sebastianl1" target="_blank" rel="noreferrer" aria-label="GitHub" class="mt-3 inline-flex h-9 w-9 items-center justify-center rounded-lg border border-line hover:border-accent transition-colors">
              <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
            </a>
          </div>
        </div>
        <div class="hairline my-6"></div>
        <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-muted">
          <span>{t.footer}</span>
          <span class="mono">v2.1.0</span>
        </div>
      </div>
    </footer>
  </body>
</html>