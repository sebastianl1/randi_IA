---
import '../styles/global.css';
import { content } from '../i18n.js';
interface Props { lang?: 'es' | 'en'; title: string; description: string }
const { lang = 'es', title, description } = Astro.props;
const t = content[lang];
const base = import.meta.env.BASE_URL;
const canonical = lang === 'es' ? Astro.site : new URL('en/', Astro.site!);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'RANDI',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Android, Linux, macOS, Windows, WSL2',
  description: 'Asistente de IA 100% local multiplataforma para Termux, Linux, macOS y Windows. Detecta hardware y ejecuta modelos de texto, imagen y video.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: 'Sebastian Laguna' },
  url: Astro.site?.href,
};
---
<!doctype html>
<html lang={lang === 'es' ? 'es' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="es" href={Astro.site?.href} />
    <link rel="alternate" hreflang="en" href={new URL('en/', Astro.site!).href} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center gap-6 px-4 h-14">
        <a href={lang === 'es' ? base : `${base}en/`} class="flex items-center gap-2 font-bold tracking-tight">
          <span class="inline-flex h-7 w-7 items-center justify-center rounded-lg" style="color:var(--color-accent);border:1px solid var(--color-line)">Ρ</span>
          <span>RANDI</span>
        </a>
        <nav class="hidden sm:flex items-center gap-5 text-sm text-muted">
          <a href={lang === 'es' ? '#arch' : `${base}en/#arch`} class="hover:text-ink transition-colors">{lang === 'es' ? 'En qué consiste' : 'About'}</a>
          <a href="#modes" class="hover:text-ink transition-colors">{lang === 'es' ? 'Modos' : 'Modes'}</a>
          <a href="#install" class="hover:text-ink transition-colors">{t.nav.install}</a>
          <a href="#faq" class="hover:text-ink transition-colors">FAQ</a>
        </nav>
        <div class="ml-auto flex items-center gap-3 text-sm">
          <a href={lang === 'es' ? `${base}en/` : base} class="pill hover:text-ink">{lang === 'es' ? 'EN' : 'ES'}</a>
          <a href="https://github.com/sebastianl1/randi_IA" target="_blank" rel="noreferrer" class="hover:text-ink">{t.nav.github} ↗</a>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="border-t border-line mt-16">
      <div class="mx-auto max-w-6xl px-4 py-8 text-xs text-muted flex flex-wrap gap-x-6 gap-y-2">
        <span>{t.footer}</span>
        <a href="https://github.com/sebastianl1/randi_IA" class="hover:text-ink" target="_blank" rel="noreferrer">GitHub</a>
        <span class="mono">v2.0.0</span>
      </div>
    </footer>
  </body>
</html>