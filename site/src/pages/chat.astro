---
import Layout from '../layouts/Layout.astro';
import '../styles/chat.css';
import { mountChat } from '../lib/demo-chat.js';
const base = import.meta.env.BASE_URL;
const donarUrl = `${base}donar/`;
const L = {
  badge: 'chatea',
  brand: 'RANDI · Chatea',
  tagline: 'Modelos de IA online, contexto 100% local.',
  sessions: 'Conversaciones',
  ctxL: 'Contexto',
  newConv: 'Nueva conversación',
  exportB: 'Exportar',
  clearB: 'Borrar',
  copyAll: 'Copiar chat',
  priv: 'Privacidad y límite',
  priv1: 'Cero cookies · contexto en tu dispositivo',
  priv2: 'Sin cuenta · 40 msgs/día por IP (se reinicia)',
  soon: 'Próximamente: imágenes, más modelos, voz',
  sponsor: 'Patrocina RANDI',
  modelsL: 'Modelos disponibles',
  tasksL: 'Tareas del agente',
  placeholder: 'Escribí tu mensaje…  (Enter envía · Shift+Enter salto de línea)',
  send: 'Enviar',
  stop: 'Detener',
  title: 'RANDI — Chatea con nosotros',
  desc: 'Probá modelos de IA online sin instalar nada: chat con streaming, contexto local en tu navegador y sin cuenta.',
};
const t = { title: L.title, desc: L.desc };
---
<Layout lang="es" title={t.title} description={t.desc}>
  <div id="chat-online" class="chat-app">
    <header class="chat-header">
      <button type="button" data-cd-open-side class="btn btn-dark text-xs !px-2.5 side-open-btn" aria-label="Menú">☰</button>
      <a href={base} class="chat-brand">
        <span class="greek-glyph nav">Ρ</span><span>{L.brand}</span>
      </a>
      
      <div class="grow"></div>
      <div class="chat-header-actions">
        <button type="button" class="model-active" data-cd-model-label data-goto-models></button>
        <span class="limit-pill" data-cd-limit></span>
        <span class="pill" style="border-color:var(--color-accent);color:var(--color-accent)">● online</span>
        <a href={donarUrl} class="btn btn-dark text-xs !px-3 !py-1.5">{L.sponsor}</a>
      </div>
    </header>

    <div class="chat-cols">
      <aside class="chat-sidebar">
        <div>
          <p class="side-label mb-2">{L.sessions}</p>
          <div data-cd-sessions class="sess-list"></div>
          <button type="button" data-cd-new class="btn btn-primary w-full !py-2 text-xs mt-3">+ {L.newConv}</button>
        </div>
        <div>
          <p class="side-label mb-2">{L.ctxL}</p>
          <div class="status-row">
            <span data-cd-count></span>
            <span class="sp">·</span>
            <span data-cd-tokens></span>
          </div>
          <div class="flex gap-2 mt-2">
            <button type="button" data-cd-export class="btn btn-dark text-xs !px-3 !py-1.5 flex-1">{L.exportB}</button>
            <button type="button" data-cd-copyall class="btn btn-dark text-xs !px-3 !py-1.5 flex-1">{L.copyAll}</button>
            <button type="button" data-cd-clear class="btn btn-dark text-xs !px-3 !py-1.5">{L.clearB}</button>
          </div>
        </div>
        <div class="mt-auto space-y-3">
          <div>
            <p class="side-label mb-1">{L.priv}</p>
            <ul class="space-y-1.5 text-xs text-muted">
              <li class="flex items-start gap-2"><span class="cd-check">✓</span>{L.priv1}</li>
              <li class="flex items-start gap-2"><span class="cd-check">✓</span>{L.priv2}</li>
            </ul>
          </div>
          <p class="text-[11px] text-muted leading-relaxed">{L.soon}</p>
        </div>
      </aside>
      <div data-cd-scrim class="side-scrim"></div>

      <main class="chat-canvas">
        <div class="chat-scroll">
          <div class="chat-col" data-cd-msgs></div>
        </div>
        <section class="chat-composer">
          <div class="composer">
            <div class="composer-box">
              <textarea data-cd-input rows="1" placeholder={L.placeholder}></textarea>
              <button type="button" data-cd-send class="btn-send" aria-label={L.send}>{L.send} →</button>
              <button type="button" data-cd-stop class="btn btn-dark text-xs !px-3 !py-1.5" hidden>{L.stop}</button>
            </div>
            <div class="composer-foot">
              <span class="status-row">
                <span class="dot-online" />online ·
                <span data-cd-count></span> ·
                <span data-cd-tokens></span>
              </span>
            </div>
          </div>
        </section>
      </main>

      <aside class="chat-right">
        <section>
          <p class="r-label">{L.modelsL}</p>
          <div data-cd-models-list class="model-list"></div>
        </section>
        <section class="mt-auto">
          <p class="r-label">{L.tasksL}</p>
          <div data-cd-tasks-list class="task-list"></div>
          <div class="task-meter">
            <div class="task-bar"><span data-cd-task-bar></span></div>
            <span class="task-nums" data-cd-task-nums></span>
          </div>
        </section>
      </aside>
    </div>
  </div>

  <script>
    import { mountChat } from '../lib/demo-chat.js';
    void mountChat();
  </script>
    <section class="m-views">
        <div class="m-tab" data-mtab="models">
          <p class="r-label">{L.modelsL}</p>
          <div data-cd-models-list-m class="model-list"></div>
        </div>
        <div class="m-tab" data-mtab="tasks">
          <p class="r-label">{L.tasksL}</p>
          <div data-cd-tasks-list-m class="task-list"></div>
          <div class="task-meter">
            <div class="task-bar"><span data-cd-task-bar-m></span></div>
            <span class="task-nums" data-cd-task-nums-m></span>
          </div>
        </div>
      </section>
      <nav class="tabbar">
        <button type="button" data-mtab="chat" class="on"><span class="ic">💬</span>Chat</button>
        <button type="button" data-mtab="models"><span class="ic">🤖</span>Modelos</button>
        <button type="button" data-mtab="tasks"><span class="ic">✓</span>Tareas</button>
      </nav>
    <p class="chat-watermark">RANDI — hecho por Sebastián Laguna</p>
  </div>
</Layout>