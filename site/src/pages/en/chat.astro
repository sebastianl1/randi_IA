---
import Layout from '../../layouts/Layout.astro';
import '../../styles/chat.css';
import { mountChat } from '../../lib/demo-chat.js';
const base = import.meta.env.BASE_URL;
const donarUrl = `${base}en/donar/`;
const L = {
  badge: 'chat',
  brand: 'RANDI · Chat',
  tagline: 'Online AI models, 100% local context.',
  sessions: 'Conversations',
  ctxL: 'Context',
  newConv: 'New conversation',
  exportB: 'Export',
  clearB: 'Clear',
  priv: 'Privacy and limit',
  priv1: 'Zero cookies · context on your device',
  priv2: 'No account · 40 msgs/day per IP (resets)',
  soon: 'Coming soon: images, more models, voice',
  sponsor: 'Sponsor RANDI',
  placeholder: 'Type your message…  (Enter sends · Shift+Enter newline)',
  send: 'Send',
  stop: 'Stop',
  title: 'RANDI — Chat with us',
  desc: 'Try AI models online with nothing to install: streaming chat, local context in your browser, no account.',
};
const t = { title: L.title, desc: L.desc };
---
<Layout lang="en" title={t.title} description={t.desc}>
  <div id="chat-online" class="chat-app">
    <header class="chat-header">
      <a href={`${base}en/`} class="chat-brand">
        <span class="greek-glyph nav">Ρ</span><span>{L.brand}</span>
      </a>
      <button type="button" data-cd-open-side class="btn btn-dark text-xs !px-2.5" aria-label="Menu">☰</button>
      <div class="grow"></div>
      <div class="chat-header-actions">
        <div class="model-wrap">
          <button type="button" data-cd-model class="model-chip"><span class="dot" />{L.tagline}</button>
          <div data-cd-models class="model-menu"></div>
        </div>
        <span class="pill" style="border-color:var(--color-accent);color:var(--color-accent)">● online</span>
        <a href={donarUrl} class="btn btn-dark text-xs !px-3 !py-1.5">{L.sponsor}</a>
      </div>
    </header>

    <div class="chat-cols">
      <aside class="chat-sidebar">
        <div>
          <p class="side-label mb-2">{L.sessions}</p>
          <div data-cd-sessions class="sess-list"></div>
          <button type="button" data-cd-new class="btn btn-primary w-full !py-2 text-xs mt-3">+ {L.newConv}</button>
        </div>
        <div>
          <p class="side-label mb-2">{L.ctxL}</p>
          <div class="status-row">
            <span data-cd-count></span>
            <span class="sp">·</span>
            <span data-cd-tokens></span>
          </div>
          <div class="flex gap-2 mt-2">
            <button type="button" data-cd-export class="btn btn-dark text-xs !px-3 !py-1.5 flex-1">{L.exportB}</button>
            <button type="button" data-cd-clear class="btn btn-dark text-xs !px-3 !py-1.5" style="color:var(--color-bad)">{L.clearB}</button>
          </div>
        </div>
        <div class="mt-auto space-y-3">
          <div>
            <p class="side-label mb-1">{L.priv}</p>
            <ul class="space-y-1.5 text-xs text-muted">
              <li class="flex items-start gap-2"><span class="cd-check">✓</span>{L.priv1}</li>
              <li class="flex items-start gap-2"><span class="cd-check">✓</span>{L.priv2}</li>
            </ul>
          </div>
          <p class="text-[11px] text-muted leading-relaxed">{L.soon}</p>
        </div>
      </aside>
      <div data-cd-scrim class="side-scrim"></div>

      <main class="chat-canvas">
        <div class="chat-scroll">
          <div class="chat-col" data-cd-msgs></div>
        </div>
        <section class="chat-composer">
          <div class="composer">
            <div data-cd-sugg class="sugg-row"></div>
            <div class="composer-box">
              <textarea data-cd-input rows="1" placeholder={L.placeholder}></textarea>
              <button type="button" data-cd-send class="btn-send" aria-label={L.send}>{L.send} →</button>
              <button type="button" data-cd-stop class="btn btn-dark text-xs !px-3 !py-1.5" hidden>{L.stop}</button>
            </div>
            <div class="composer-foot">
              <span class="status-row">
                <span class="dot-online" />online ·
                <span data-cd-count></span> ·
                <span data-cd-tokens></span>
              </span>
            </div>
          </div>
        </section>
      </main>
    </div>
  </div>

  <script>
    import { mountChat } from '../../lib/demo-chat.js';
    void mountChat();
  </script>
</Layout>