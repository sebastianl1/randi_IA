---
import Layout from '../../layouts/Layout.astro';
import { mountChat } from '../../lib/demo-chat.js';
const base = import.meta.env.BASE_URL;
const donarUrl = `${base}en/donar/`;
const L = {
  badge: 'chat now',
  title: 'Try AI online, nothing to install',
  sub: 'Light, free-to-use models running in the cloud. Your conversation stays in your browser, with JSON export.',
  pick: 'Pick your model',
  pickD: 'Each model keeps its own context on your device.',
  modelList: '4 online models available (free):',
  ctxT: 'Context',
  ctxD: 'Each conversation is saved in your browser (localStorage) per model. Export it or start fresh anytime.',
  privT: 'Privacy and limit',
  priv1: 'Zero cookies and zero tracking.',
  priv2: 'No account and no card.',
  priv3: 'Free daily limit per IP; resets every day.',
  soon: 'Coming soon',
  soon1: 'Images (Hugging Face)',
  soon2: 'More online models',
  soon3: 'Voice and audio',
  soonD: 'The "Chat with us" grows. This is already planned for upcoming versions.',
  sponsor: 'Sponsor RANDI',
  send: 'Send',
  stop: 'Stop',
  placeholder: 'Type your message…',
  exportB: 'Export',
  clearB: 'Clear',
  newB: 'New conversation',
  hint: 'Enter to send · Shift+Enter for newline',
  about: 'About this chat',
};
const t = {
  title: 'RANDI — Chat with us',
  desc: 'Try AI models online with nothing to install: streaming chat, local context in your browser, no account.',
};
const modelsOnline = [
  'Qwen Coder 32B · code',
  'Llama 3.1 8B · general',
  'Llama 3.2 3B · light',
  'Llama 3.2 1B · ultra-light',
];
---
<Layout lang="en" title={t.title} description={t.desc}>
  <section class="mx-auto max-w-6xl px-4 pt-14 pb-16">
    <p class="mono text-xs uppercase tracking-widest text-muted text-center">{L.badge}</p>
    <h1 class="mt-2 text-center text-4xl md:text-5xl font-black tracking-tight">{L.title}</h1>
    <p class="mx-auto mt-3 max-w-2xl text-center text-muted leading-relaxed">{L.sub}</p>

    <div id="chat-online" class="mt-10 grid gap-5 lg:grid-cols-[1.2fr_0.8fr] items-start">

      <div class="card p-5 flex flex-col gap-3">
        <div class="flex flex-wrap items-center justify-between gap-2.5">
          <div class="flex items-center gap-2.5 flex-wrap">
            <span class="pill" style="border-color:var(--color-accent);color:var(--color-accent)">● online</span>
            <span class="mono text-xs text-muted" data-cd-model-label></span>
            <span class="mono text-[10px] text-muted" data-cd-count></span>
            <span class="mono text-[10px] text-muted" data-cd-tokens></span>
          </div>
          <div class="flex gap-2">
            <button data-cd-new class="btn btn-primary text-xs !px-3 !py-1.5">{L.newB}</button>
            <button data-cd-export class="btn btn-dark text-xs !px-3 !py-1.5">{L.exportB}</button>
            <button data-cd-clear class="btn btn-dark text-xs !px-3 !py-1.5" style="color:var(--color-bad)">{L.clearB}</button>
          </div>
        </div>

        <div data-cd-sugg class="cd-sugg-row"></div>
        <div data-cd-msgs class="cd-msgs"></div>

        <textarea data-cd-input class="cd-input" rows="2" placeholder={L.placeholder}></textarea>
        <div class="flex items-center justify-between gap-2">
          <span class="mono text-[10px] text-muted">{L.hint}</span>
          <div class="flex gap-2">
            <button data-cd-stop class="btn btn-dark text-xs !px-3 !py-1.5" hidden>{L.stop}</button>
            <button data-cd-send class="btn btn-primary text-xs !px-4 !py-1.5">{L.send} →</button>
          </div>
        </div>
      </div>

      <div class="space-y-4">
        <div class="card p-5">
          <p class="font-semibold mb-1">{L.pick}</p>
          <select data-cd-model class="cd-select"></select>
          <p class="mt-2 text-xs text-muted">{L.pickD}</p>
          <p class="mt-3 text-[11px] font-semibold text-muted">{L.modelList}</p>
          <ul class="mt-1.5 space-y-1 text-xs text-muted">
            {modelsOnline.map((m) => <li class="flex items-center gap-2"><span class="cd-dot" />{m}</li>)}
          </ul>
        </div>

        <div class="card p-5">
          <p class="font-semibold mb-1">{L.ctxT}</p>
          <div class="flex gap-3 mt-2 mono text-xs text-muted">
            <span data-cd-count></span>
            <span data-cd-tokens></span>
          </div>
          <p class="mt-2 text-xs text-muted leading-relaxed">{L.ctxD}</p>
          <div class="flex gap-2 mt-3">
            <button data-cd-export class="btn btn-dark text-xs !px-3 !py-1.5 flex-1">{L.exportB}</button>
            <button data-cd-clear class="btn btn-dark text-xs !px-3 !py-1.5" style="color:var(--color-bad)">{L.clearB}</button>
          </div>
        </div>

        <div class="card p-5">
          <p class="font-semibold mb-2">{L.privT}</p>
          <ul class="space-y-2 text-xs text-muted">
            <li class="flex items-start gap-2"><span class="cd-check">✓</span>{L.priv1}</li>
            <li class="flex items-start gap-2"><span class="cd-check">✓</span>{L.priv2}</li>
            <li class="flex items-start gap-2"><span class="cd-check">✓</span>{L.priv3}</li>
          </ul>
        </div>

        <div class="card p-5 opacity-85">
          <p class="mono text-[10px] uppercase tracking-widest text-muted mb-2">{L.soon}</p>
          <div class="flex flex-col gap-1.5 text-sm text-muted">
            <span>· {L.soon1}</span>
            <span>· {L.soon2}</span>
            <span>· {L.soon3}</span>
          </div>
          <p class="mt-2 text-[11px] text-muted leading-relaxed">{L.soonD}</p>
        </div>

        <a href={donarUrl} class="btn btn-dark justify-center">{L.sponsor}</a>
      </div>
    </div>
  </section>

  <style>
    .cd-select {
      width: 100%; appearance: none;
      background: var(--color-bg-soft); color: var(--color-ink);
      border: 1px solid var(--color-line); border-radius: .5rem;
      padding: .625rem .75rem; font: inherit; font-size: .875rem;
    }
    .cd-select:focus { outline: 2px solid var(--color-accent); outline-offset: 1px; }
    .cd-dot { width: .4rem; height: .4rem; border-radius: 99px; background: var(--color-accent); flex: none; opacity: .8; }
    .cd-check { color: var(--color-accent); font-weight: 800; flex: none; }
    .cd-sugg-row { display: flex; gap: .5rem; flex-wrap: wrap; }
    .cd-sugg {
      font-size: .72rem; padding: .28rem .7rem; border-radius: 99px;
      border: 1px solid var(--color-line); color: var(--color-muted);
      background: transparent; cursor: pointer; transition: color .15s, border-color .15s;
    }
    .cd-sugg:hover { color: var(--color-ink); border-color: var(--color-accent); }
    .cd-msgs {
      flex: 1; min-height: 22rem; max-height: 30rem; overflow-y: auto;
      display: flex; flex-direction: column; gap: .625rem; padding-right: .25rem;
    }
    .cd-bubble {
      max-width: 86%; padding: .55rem .8rem; border-radius: .8rem;
      font-size: .875rem; line-height: 1.55; white-space: pre-wrap; word-break: break-word;
    }
    .cd-bubble.user { align-self: flex-end; background: var(--color-accent); color: #1a0506; }
    .cd-bubble.assistant { align-self: flex-start; background: var(--color-bg-soft); border: 1px solid var(--color-line); }
    .cd-bubble.typing { align-self: flex-start; color: var(--color-muted); border-style: dashed; opacity: .8; animation: cd-pulse 1s ease-in-out infinite; }
    .cd-note { font-size: .8rem; color: var(--color-warn); line-height: 1.5; }
    @keyframes cd-pulse { 50% { opacity: .45; } }
    .cd-input {
      width: 100%; resize: none; background: var(--color-bg-soft); color: var(--color-ink);
      border: 1px solid var(--color-line); border-radius: .5rem; padding: .625rem .75rem;
      font: inherit; font-size: .875rem; line-height: 1.4;
    }
    .cd-input:focus { outline: 2px solid var(--color-accent); outline-offset: 1px; }
  </style>

  <script>
    import { mountChat } from '../../lib/demo-chat.js';
    void mountChat();
  </script>
</Layout>