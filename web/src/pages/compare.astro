---
import Layout from '../layouts/Layout.astro';
import { llmModels, mediaModels } from '../lib/catalog.js';
const options = [...llmModels, ...mediaModels]
  .sort((a, b) => a.name.localeCompare(b.name))
  .map((m) => `<option value="${m.id}">${m.name} (${m.paramsBillions}B)</option>`)
  .join('');
---
<Layout title="RANDI — Comparar modelos">
  <p class="mono text-xs tracking-widest uppercase text-muted mb-1">Compare</p>
  <h1 class="text-3xl font-black tracking-tight">Comparar dos modelos</h1>
  <p class="mt-2 text-muted text-sm" id="cmpState">Seleccioná dos modelos para tu hardware.</p>

  <div class="mt-6 grid sm:grid-cols-2 gap-3">
    <select id="a" class="select" set:html={options}></select>
    <select id="b" class="select" set:html={options}></select>
  </div>

  <div id="cmp" class="mt-6 grid gap-4 lg:grid-cols-2"></div>
</Layout>

<script>
  import { mount } from '../scripts/compare';
  mount();
</script>