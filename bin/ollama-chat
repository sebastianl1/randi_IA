#!/usr/bin/env bash
# RANDI Chat - Wrapper directo para la UI interactiva (Textual).

RANDI_DIR="${RANDI_DIR:-$HOME/.local/share/randi}"
LIB_DIR=""
for base in \
    "$(cd "$(dirname "$0")" && pwd)/lib" \
    "$PWD/lib" \
    "$RANDI_DIR/lib" \
    "$HOME/.local/share/randi/lib"; do
    if [ -f "$base/catalog.py" ] && [ -d "$base/randi_tui" ]; then
        LIB_DIR="$base"
        break
    fi
done

if [ -z "$LIB_DIR" ]; then
    echo "Error: No se encuentra la interfaz randi_tui"
    echo "Asegurate de haber ejecutado install-ollama.sh"
    exit 1
fi

if ! curl -sf "${OLLAMA_HOST:-http://localhost:11434}/api/tags" > /dev/null 2>&1; then
    echo "Iniciando servidor Ollama..."
    nohup ollama serve > /dev/null 2>&1 &
    disown 2>/dev/null || true
    sleep 3
fi

PYTHONPATH="$LIB_DIR" python3 -m randi_tui.app "$@"