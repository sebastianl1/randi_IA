    -h|--help|help)
        echo ""
        echo -e "${BLU}${B}RANDI v$RANDI_VERSION${R} - ${GRN}Asistente IA local multiplataforma${R}"
        echo -e "${D}Creado por $RANDI_AUTHOR${R}"
        echo ""
        echo -e "${CYN}Uso:${R} randi ${D}<comando>${R} ${D}[opciones]${R}"
        echo ""
        echo -e "  ${B}randi${R}                  ${D}Menu interactivo${R}"
        echo -e "  ${B}randi chat${R} ${D}[modelo]${R}    ${D}Chat TUI con Rich${R}"
        echo -e "  ${B}randi run${R} ${D}[modelo]${R}     ${D}Ejecuta modelo directamente${R}"
        echo -e "  ${B}randi serve${R}              ${D}Inicia servidor Ollama${R}"
        echo -e "  ${B}randi stop${R}               ${D}Detiene servidor Ollama${R}"
        echo -e "  ${B}randi pull${R} ${D}[modelo]${R}   ${D}Descarga modelo(s)${R}"
        echo -e "  ${B}randi list${R}               ${D}Lista modelos instalados${R}"
        echo -e "  ${B}randi ps${R}                 ${D}Modelos en RAM${R}"
        echo -e "  ${B}randi models${R}             ${D}Catalogo recomendado${R}"
        echo -e "  ${B}randi status${R}             ${D}Estado del sistema${R}"
        echo -e "  ${B}randi config${R}             ${D}Ver configuracion${R}"
        echo -e "  ${B}randi update${R}             ${D}Actualizar${R}"
        echo -e "  ${B}randi web${R} ${D}[puerto]${R}      ${D}Interfaz web local${R}"
        echo -e "  ${B}randi img${R} ${D}\"prompt\"${R}       ${D}Generar imagen (A1111/GPU)${R}"
        echo -e "  ${B}randi doctor${R}             ${D}Diagnostico del sistema${R}"
        echo -e "  ${B}randi hardware${R}           ${D}Detecta CPU/GPU/RAM/VRAM/bandwidth${R}"
        echo -e "  ${B}randi recommend${R} ${D}[uc]${R}    ${D}Mejores modelos para TU equipo${R}"
        echo -e "  ${B}randi tier${R}               ${D}Tier list S-F de tu hardware${R}"
        echo -e "  ${B}randi compare${R} ${D}a b${R}        ${D}Compara 2 modelos${R}"
        echo -e "  ${B}randi install${R} ${D}<m>${R}       ${D}Instala + configura un modelo${R}"
        echo -e "  ${B}randi setup${R}              ${D}Onboarding: hardware -> mejores modelos${R}"
