#!/usr/bin/env bash

# Auto-reparar PATH: si este script no está en PATH, agregar su directorio
_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
if [[ -n "$_SCRIPT_DIR" && ":$PATH:" != *":$_SCRIPT_DIR:"* ]]; then
    export PATH="$_SCRIPT_DIR:$PATH"
fi

RANDI_DIR="${RANDI_DIR:-$HOME/.local/share/randi}"
OLLAMA_HOST="${OLLAMA_HOST:-http://localhost:11434}"
RANDI_VERSION="2.0.1"
RANDI_AUTHOR="Sebastian Laguna"
RANDI_REPO="${RANDI_REPO:-https://github.com/sebastianl1/randi_IA.git}"
REPO_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"

detect_platform() {
    if [ -d "/data/data/com.termux" ]; then
        echo "termux"
    elif [ -n "${MSYSTEM:-}" ] || [ -n "${MINGW_PREFIX:-}" ]; then
        echo "windows"
    elif [ "$(uname -s)" = "Darwin" ]; then
        echo "macos"
    elif [ -n "${WSL_DISTRO_NAME:-}" ] || grep -qi microsoft /proc/version 2>/dev/null; then
        echo "wsl"
    else
        echo "linux"
    fi
}
PLATFORM="$(detect_platform)"

open_url() {
    local url="$1"
    case "$PLATFORM" in
        termux) am start --user 0 -a android.intent.action.VIEW -d "$url" >/dev/null 2>&1 || true ;;
        macos) open "$url" >/dev/null 2>&1 || true ;;
        windows) cmd.exe /c start "" "$url" >/dev/null 2>&1 || true ;;
        *) xdg-open "$url" >/dev/null 2>&1 || true ;;
    esac
}

R='\033[0m'; B='\033[1m'; D='\033[2m'; I='\033[3m'
RED='\033[0;31m'; GRN='\033[0;32m'; YLW='\033[1;33m'; BLU='\033[0;34m'
CYN='\033[0;36m'; MGN='\033[0;35m'

info()  { echo -e "${BLU}${B}◆${R} $1"; }
ok()    { echo -e "${GRN}${B}◆${R} $1"; }
warn()  { echo -e "${YLW}${B}◆${R} $1"; }
err()   { echo -e "${RED}${B}◆${R} $1"; }
dim()   { echo -e "${D}$1${R}"; }
title() { echo -e "\n${BLU}${B}── $1 ──${R}\n"; }
hr()    { echo -e "${D}────────────────────────────────────────${R}"; }

find_chat_script() {
    local script
    script="$RANDI_DIR/lib/ollama_chat.py"
    if [ -f "$script" ]; then
        echo "$script"
        return 0
    fi
    script="$(cd "$(dirname "$0")" && pwd)/lib/ollama_chat.py"
    if [ -f "$script" ]; then
        echo "$script"
        return 0
    fi
    script="$PWD/lib/ollama_chat.py"
    if [ -f "$script" ]; then
        echo "$script"
        return 0
    fi
    return 1
}

find_py_script() {
    local name="$1" script
    for base in "$(cd "$(dirname "$0")" 2>/dev/null && pwd)/lib" "$REPO_DIR/lib" "$RANDI_DIR/lib" "$PWD/lib" "$HOME/.local/share/randi/lib"; do
        if [ -f "$base/$name" ]; then
            echo "$base/$name"
            return 0
        fi
    done
    return 1
}

server_running() {
    curl -sf "$OLLAMA_HOST/api/tags" > /dev/null 2>&1
}

cmd_serve() {
    if server_running; then
        ok "Servidor Ollama ya esta corriendo en $OLLAMA_HOST"
        return 0
    fi
    if ! command -v ollama >/dev/null 2>&1; then
        err "Ollama no esta instalado. Ejecuta: bash install-ollama.sh"
        return 1
    fi
    if [ "$PLATFORM" = "windows" ]; then
        info "En Windows nativo, Ollama corre como servicio de Windows."
        info "Verifica que este iniciado (busca 'Ollama' en la bandeja del sistema)"
        info "o reinicia la aplicacion Ollama desde el menu de inicio."
        for i in $(seq 1 10); do
            sleep 2
            if server_running; then
                ok "Servidor Ollama activo (servicio de Windows)"
                return 0
            fi
        done
        err "El servicio Ollama no responde. Inicialo manualmente."
        return 1
    fi
    info "Iniciando servidor Ollama..."
    nohup ollama serve > /dev/null 2>&1 &
    local pid=$!
    disown "$pid" 2>/dev/null || true
    for i in $(seq 1 15); do
        sleep 1
        if server_running; then
            ok "Servidor Ollama iniciado (PID: $pid)"
            return 0
        fi
    done
    err "No se pudo iniciar el servidor"
    return 1
}

cmd_web() {
    local port="${1:-8080}"
    local script=""

    local repo_parent
    repo_parent="$(cd "$REPO_DIR/.." 2>/dev/null && pwd)"

    # Buscar server.py
    if [ -f "$repo_parent/web/server.py" ]; then
        script="$repo_parent/web/server.py"
    elif [ -f "$PWD/web/server.py" ]; then
        script="$PWD/web/server.py"
    elif [ -f "$RANDI_DIR/web/server.py" ]; then
        script="$RANDI_DIR/web/server.py"
    elif [ -f "$HOME/.local/share/randi/web/server.py" ]; then
        script="$HOME/.local/share/randi/web/server.py"
    fi

    if [ -z "$script" ]; then
        err "No se encuentra web/server.py"
        err "Asegurate de tener los archivos web en el repositorio RANDI"
        exit 1
    fi

    echo ""
    echo -e "${BLU}${B}╭────────────────────────────────────────╮${R}"
    echo -e "${BLU}${B}│${R}  ${CYN}RANDI Web${R} - Interfaz web local         ${BLU}${B}│${R}"
    echo -e "${BLU}${B}│${R}  Modelos via Ollama + WebGPU           ${BLU}${B}│${R}"
    echo -e "${BLU}${B}╰────────────────────────────────────────╯${R}"
    echo ""

    info "Iniciando servidor web..."

    python3 "$script" --port "$port"
}

cmd_stop() {
    local pids
    if command -v pgrep >/dev/null 2>&1; then
        pids=$(pgrep -f "ollama serve" 2>/dev/null || true)
    else
        pids=$(ps aux 2>/dev/null | grep "[o]llama serve" | awk '{print $2}' 2>/dev/null || true)
    fi
    if [ -z "$pids" ]; then
        warn "El servidor no esta corriendo"
        return 0
    fi
    kill $pids 2>/dev/null || true
    ok "Servidor detenido"
}

check_ram() {
    local mem_total_kb=0 mem_avail_kb=0 mem_total_gb mem_avail_gb
    if [ -f /proc/meminfo ]; then
        mem_total_kb=$(grep MemTotal /proc/meminfo | awk '{print $2}')
        mem_avail_kb=$(grep MemAvailable /proc/meminfo | awk '{print $2}')
    elif [ "$PLATFORM" = "macos" ]; then
        local mem_bytes page_size pages_free
        mem_bytes=$(sysctl -n hw.memsize 2>/dev/null || echo 0)
        page_size=$(sysctl -n vm.page_size 2>/dev/null || echo 4096)
        mem_total_kb=$((mem_bytes / 1024))
        pages_free=$(vm_stat 2>/dev/null | awk '/Pages free/{gsub(/\./,"",$3); print $3}' | head -1)
        mem_avail_kb=$((pages_free * page_size / 1024))
    fi
    if [ "$mem_total_kb" -gt 0 ]; then
        mem_total_gb=$((mem_total_kb / 1024 / 1024))
        mem_avail_gb=$((mem_avail_kb / 1024 / 1024))

        local model="${1:-}"
        local needed=4
        case "$model" in
            *70b*) needed=40 ;;
            *13b*) needed=8 ;;
            *8b*) needed=6 ;;
            *7b*) needed=6 ;;
            *4b*) needed=3 ;;
            *3.8b*|*3b*) needed=2.5 ;;
            *2b*|*phi3:mini*) needed=2 ;;
            *1.5b*) needed=1.5 ;;
            *0.5b*|*1b*) needed=1 ;;
        esac
        local needed_int
        needed_int=$(printf "%.0f" "$needed" 2>/dev/null || echo "$needed")

        if [ "$mem_avail_gb" -lt "$needed_int" ] 2>/dev/null; then
            warn "RAM disponible: ~${mem_avail_gb}GB de ${mem_total_gb}GB"
            warn "El modelo '$model' puede necesitar ~${needed}GB de RAM"
            dim "  Recomendados para tu dispositivo:"
            dim "    randi chat -m deepseek-r1:1.5b  (1.1GB)"
            dim "    randi chat -m gemma3:1b        (1.5GB)"
            dim "    randi chat -m qwen2.5-coder:0.5b (0.4GB)"
            echo ""
            echo -n "Continuar de todas formas? (s/N): "
            read -r confirm
            if [ "$confirm" != "s" ] && [ "$confirm" != "S" ]; then
                err "Cancelado"
                return 1
            fi
        fi
    fi
    return 0
}

cmd_chat() {
    local model="${1:-}"
    local chat_script
    chat_script=$(find_chat_script) || {
        err "No se encuentra ollama_chat.py"
        exit 1
    }

    # Determinar el modelo a usar para la verificacion de RAM
    local check_model="$model"
    if [ -z "$check_model" ] && [ -f "$HOME/.config/randi/config.json" ]; then
        check_model=$(python3 -c "import json; print(json.load(open('$HOME/.config/randi/config.json')).get('model',''))" 2>/dev/null || echo "")
    fi
    if [ -n "$check_model" ]; then
        check_ram "$check_model" || return 1
    fi

    if ! server_running; then
        cmd_serve || return 1
    fi
    if [ -n "$model" ]; then
        python3 "$chat_script" -m "$model"
    else
        python3 "$chat_script"
    fi
}

cmd_run() {
    if ! server_running; then
        cmd_serve
    fi
    local model="${1:-}"
    if [ -z "$model" ]; then
        local models
        models=$(ollama list 2>/dev/null | tail -n +2 | awk '{print $1}')
        if [ -z "$models" ]; then
            err "No hay modelos instalados. Usa: randi pull"
            return 1
        fi
        echo "Selecciona un modelo:"
        select model in $models; do
            if [ -n "$model" ]; then
                break
            fi
        done
    fi
    if [ -z "$model" ]; then
        return 1
    fi
    ollama run "$model"
}

cmd_pull() {
    local pull_script
    pull_script=$(find_py_script pull.py) || {
        err "No se encuentra pull.py (reinstala RANDI)"
        return 1
    }
    if ! server_running; then
        cmd_serve
    fi
    python3 "$pull_script" "$@"
}

cmd_list() {
    if server_running; then
        echo -e "\n${BLU}${B}Modelos instalados:${R}"
        hr
        curl -sf "$OLLAMA_HOST/api/tags" | python3 -c "
import json,sys
data=json.load(sys.stdin)
for m in data.get('models',[]):
    s=m.get('size',0)
    if s>1e9:
        sz=f'{s/1e9:.1f}GB'
    elif s>1e6:
        sz=f'{s/1e6:.1f}MB'
    else:
        sz=f'{s:.0f}B'
    print(f'  {m[\"name\"]:<35} {sz:>8}')
" 2>/dev/null || ollama list
    else
        ollama list 2>/dev/null || warn "No hay modelos o servidor no disponible"
    fi
}

cmd_ps() {
    if server_running; then
        echo -e "\n${BLU}${B}Modelos en RAM:${R}"
        hr
        curl -sf "$OLLAMA_HOST/api/ps" | python3 -c "
import json,sys
data=json.load(sys.stdin)
for m in data.get('models',[]):
    s=m.get('size',0)
    if s>1e9:
        sz=f'{s/1e9:.1f}GB'
    elif s>1e6:
        sz=f'{s/1e6:.1f}MB'
    else:
        sz=f'{s:.0f}B'
    print(f'  {m[\"name\"]:<35} {sz:>8}')
" 2>/dev/null || echo "  (ninguno)"
    else
        warn "Servidor no disponible"
    fi
}

cmd_models() {
    local catalog_script
    catalog_script=$(find_py_script catalog.py) || {
        err "No se encuentra catalog.py (reinstala RANDI)"
        return 1
    }
    echo ""
    python3 "$catalog_script" models
    echo ""
    python3 "$catalog_script" media
    echo ""
    echo -e "  ${GRN}Instalar:${R}  randi install <modelo>  (descarga + configuracion automatica)"
    echo -e "  ${GRN}Chat:${R}      randi chat -m <modelo>"
}

cmd_img() {
    local prompt="$*"
    if [ -z "$prompt" ]; then
        echo "Uso: randi img \"descripcion de la imagen\""
        echo "Requiere Automatic1111/Stable Diffusion WebUI corriendo en 127.0.0.1:7860"
        return 1
    fi
    local url="http://127.0.0.1:7860/sdapi/v1/txt2img"
    local json_prompt
    json_prompt=$(python3 -c "import json,sys; print(json.dumps(sys.argv[1]))" "$prompt")
    info "Generando imagen..."
    if ! curl -sf -X POST "$url" -H "Content-Type: application/json" \
        -d "{\"prompt\":$json_prompt,\"steps\":25,\"width\":512,\"height\":512,\"cfg_scale\":7}" \
        -o "$RANDI_DIR/img_gen.json" 2>/dev/null; then
        err "No se pudo conectar con A1111 en 127.0.0.1:7860"
        dim "  Inicia el WebUI (stable-diffusion-webui) o usa la web: randi web"
        return 1
    fi
    python3 -c "
import base64, json, sys
d = json.load(open('$RANDI_DIR/img_gen.json'))
open('$RANDI_DIR/imagen_generada.png', 'wb').write(base64.b64decode(d['images'][0]))
" 2>/dev/null || { err "Respuesta inesperada del WebUI"; return 1; }
    ok "Imagen guardada en $RANDI_DIR/imagen_generada.png"
    if [ "$PLATFORM" = "termux" ]; then
        dim "  Abrela con: am start -a android.intent.action.VIEW -d file://$RANDI_DIR/imagen_generada.png"
    fi
}

cmd_config() {
    echo ""
    echo -e "${BLU}${B}Configuracion RANDI:${R}"
    hr
    echo "  RANDI_DIR:    ${RANDI_DIR:-$HOME/.local/share/randi}"
    echo "  OLLAMA_HOST:  $OLLAMA_HOST"
    echo "  Version:      $RANDI_VERSION"
    echo "  Repositorio:  $RANDI_REPO"
    echo ""
    if [ -f "$HOME/.config/randi/config.json" ]; then
        echo "  Config JSON:"
        cat "$HOME/.config/randi/config.json" 2>/dev/null || echo "    (no disponible)"
    fi
    echo ""
    echo -e "${BLU}${B}OpenCode:${R}"
    hr
    if command -v opencode &>/dev/null; then
        echo "  opencode --version: $(opencode --version 2>/dev/null || echo '?')"
        echo "  Integracion: Configurado en opencode.jsonc"
        echo "  Uso: opencode -m ollama/modelo"
    else
        echo "  OpenCode no instalado"
    fi
}

cmd_update() {
    echo ""
    echo -e "${BLU}${B}Actualizar RANDI${R}"
    hr

    local local_repo=""
    # Detectar si estamos en el repo local
    if [ -f "$REPO_DIR/bin/randi" ] && [ -f "$REPO_DIR/install-ollama.sh" ]; then
        local_repo="$REPO_DIR"
    elif [ -f "$HOME/storage/proyectos/randi/bin/randi" ]; then
        local_repo="$HOME/storage/proyectos/randi"
    fi

    echo "  Version actual:  ${CYN}${B}$RANDI_VERSION${R}"
    echo ""
    echo "  Origen del repo: $RANDI_REPO"
    echo ""
    echo "  1) Actualizar desde GitHub"
    echo "  2) Actualizar desde repositorio local"
    echo "  3) Configurar URL del repositorio"
    echo "  0) Cancelar"
    echo ""
    echo -n "Selecciona: "
    read -r update_opt

    case "$update_opt" in
        1)
            echo ""
            info "Clonando/actualizando desde GitHub..."
            local tmp_dir
            tmp_dir=$(mktemp -d)
            if git clone --depth 1 "$RANDI_REPO" "$tmp_dir/randi" 2>/dev/null; then
                ok "Repositorio clonado."
                _do_update "$tmp_dir/randi"
                rm -rf "$tmp_dir"
            else
                err "No se pudo clonar el repositorio."
                err "Verifica la URL o tu conexion."
                echo ""
                dim "  URL actual: $RANDI_REPO"
                dim "  Para cambiarla: randi config repo <url>"
                rm -rf "$tmp_dir"
                return 1
            fi
            ;;
        2)
            if [ -z "$local_repo" ]; then
                err "No se encontro el repositorio local."
                err "Ejecuta desde el directorio del repo o usa opcion 1 (GitHub)."
                return 1
            fi
            echo ""
            info "Actualizando desde: $local_repo"
            # Verificar si hay cambios locales sin commit
            if [ -d "$local_repo/.git" ]; then
                info "Obteniendo ultimos cambios del repositorio local..."
                (cd "$local_repo" && git pull 2>/dev/null) && ok "Repo local actualizado." || warn "No se pudo hacer pull (continuando con archivos actuales)."
            fi
            _do_update "$local_repo"
            ;;
        3)
            echo ""
            echo -n "Nueva URL del repositorio GitHub: "
            read -r new_url
            if [ -n "$new_url" ]; then
                # Save to config
                local config_file="$HOME/.config/randi/config.json"
                mkdir -p "$HOME/.config/randi"
                python3 -c "
import json
cfg = {}
if __import__('os').path.exists('$config_file'):
    cfg = json.load(open('$config_file'))
cfg['repo_url'] = '$new_url'
json.dump(cfg, open('$config_file', 'w'), indent=2)
" 2>/dev/null || true
                echo "export RANDI_REPO=\"$new_url\"" >> "$HOME/.bashrc" 2>/dev/null || true
                echo "export RANDI_REPO=\"$new_url\"" >> "$HOME/.zshrc" 2>/dev/null || true
                ok "URL del repositorio actualizada a: $new_url"
                dim "  Vuelve a ejecutar 'randi update' para usar la nueva URL."
            fi
            ;;
        0|*) ;;
    esac
}

_do_update() {
    local src="$1"
    if [ ! -f "$src/bin/randi" ] || [ ! -f "$src/install-ollama.sh" ]; then
        err "El directorio no contiene un repositorio RANDI valido."
        return 1
    fi

    echo ""
    info "Actualizando scripts..."

    # Copiar scripts principales (ubicacion canonica ~/bin, fallback al repo en dev)
    local target_randi="$HOME/bin/randi"
    if [ ! -f "$target_randi" ] && [ -f "$REPO_DIR/bin/randi" ]; then
        target_randi="$REPO_DIR/bin/randi"
    fi
    if cp "$src/bin/randi" "$target_randi" 2>/dev/null; then
        chmod +x "$target_randi"
    else
        err "No se pudo instalar el script randi."
        return 1
    fi

    cp "$src/bin/ollama-chat" "$HOME/bin/ollama-chat" 2>/dev/null || true
    chmod +x "$HOME/bin/ollama-chat" 2>/dev/null || true

    # Copiar libreria Python
    mkdir -p "$RANDI_DIR/lib"
    cp "$src/bin/lib/ollama_chat.py" "$RANDI_DIR/lib/ollama_chat.py" 2>/dev/null || true
    chmod +x "$RANDI_DIR/lib/ollama_chat.py" 2>/dev/null || true
    cp "$src/bin/lib/catalog.py" "$RANDI_DIR/lib/catalog.py" 2>/dev/null || true
    cp "$src/bin/lib/pull.py" "$RANDI_DIR/lib/pull.py" 2>/dev/null || true
    for lib in compat.py hardware.py install.py recommend.py; do
        cp "$src/bin/lib/$lib" "$RANDI_DIR/lib/$lib" 2>/dev/null || true
    done

    # Copiar interfaz web
    if [ -d "$src/web" ]; then
        mkdir -p "$RANDI_DIR/web"
        cp -r "$src/web/." "$RANDI_DIR/web/" 2>/dev/null || true
    fi

    # Copiar catalogo de modelos a lib (para el TUI y menues)
    if [ -f "$src/web/models.json" ]; then
        cp "$src/web/models.json" "$RANDI_DIR/lib/models.json" 2>/dev/null || true
    fi

    # Leer nueva version
    local new_ver
    new_ver=$(grep '^RANDI_VERSION=' "$target_randi" 2>/dev/null | cut -d'"' -f2)
    echo ""
    ok "Actualizacion completada!"
    if [ -n "$new_ver" ]; then
        ok "Version: $new_ver"
    fi
    dim "  Los cambios estan activos en la proxima ejecucion."
    echo ""
}

cmd_uninstall() {
    echo ""
    echo -e "${YLW}${B}╔══════════════════════════════════════╗${R}"
    echo -e "${YLW}${B}║${R}     Desinstalar RANDI               ${YLW}${B}║${R}"
    echo -e "${YLW}${B}╚══════════════════════════════════════╝${R}"
    echo ""
    warn "Esto eliminara RANDI y todos sus componentes."
    warn "Los modelos de Ollama se conservaran (aprox 1-8GB)."
    echo ""
    echo "Se eliminara:"
    echo "  - ~/bin/randi"
    echo "  - ~/bin/ollama-chat"
    echo "  - $RANDI_DIR/"
    echo "  - $HOME/.config/randi/"
    echo "  - $HOME/.config/opencode/opencode.jsonc"
    echo "  - Entradas RANDI en ~/.bashrc, ~/.zshrc, config.fish"
    echo ""
    echo -n "Eliminar tambien Ollama? (s/N): "
    read -r remove_ollama
    echo ""
    echo -n "Confirmar desinstalacion? (s/N): "
    read -r confirm
    if [ "$confirm" != "s" ] && [ "$confirm" != "S" ]; then
        echo ""
        ok "Desinstalacion cancelada."
        return
    fi

    echo ""
    info "Desinstalando..."

    rm -f "$HOME/bin/randi" 2>/dev/null || true
    rm -f "$HOME/bin/ollama-chat" 2>/dev/null || true
    rm -rf "$RANDI_DIR" 2>/dev/null || true
    rm -rf "$HOME/.config/randi" 2>/dev/null || true
    rm -f "$HOME/.config/opencode/opencode.jsonc" 2>/dev/null || true

    for f in "$HOME/.bashrc" "$HOME/.zshrc" "$HOME/.config/fish/config.fish"; do
        [ -f "$f" ] && sed -i '/# RANDI/d' "$f" 2>/dev/null || true
        [ -f "$f" ] && sed -i '/RANDI_REPO/d' "$f" 2>/dev/null || true
        [ -f "$f" ] && sed -i '/OLLAMA_KEEP_ALIVE/d' "$f" 2>/dev/null || true
        [ -f "$f" ] && sed -i '/OLLAMA_HOST/d' "$f" 2>/dev/null || true
        [ -f "$f" ] && sed -i 's|export PATH="$HOME/bin:\$PATH"||g' "$f" 2>/dev/null || true
    done

    if [ "$remove_ollama" = "s" ] || [ "$remove_ollama" = "S" ]; then
        info "Eliminando Ollama..."
        npm uninstall -g @mmmbuto/ollama-termux 2>/dev/null || true
        rm -f "$(command -v ollama 2>/dev/null)" 2>/dev/null || true
    fi

    echo ""
    ok "RANDI desinstalado correctamente."
}

cmd_status() {
    echo ""
    echo -e "${BLU}${B}Estado de RANDI:${R}"
    hr
    if server_running; then
        ok "Servidor Ollama activo en $OLLAMA_HOST"
        local models
        models=$(ollama list 2>/dev/null | tail -n +2 | wc -l)
        echo "  Modelos instalados: $models"
        cmd_ps
    else
        err "Servidor Ollama no disponible"
        warn "Ejecuta: randi serve"
    fi
}

cmd_doctor() {
    echo ""
    echo -e "${BLU}${B}Diagnostico de RANDI v$RANDI_VERSION${R}"
    hr
    local fail=0

    if command -v python3 >/dev/null 2>&1; then
        ok "Python3: $(python3 --version 2>&1 | awk '{print $2}')"
    else
        err "Python3 no encontrado"; fail=1
    fi

    local cat_dir
    cat_dir="$(dirname "$(find_py_script catalog.py 2>/dev/null)" 2>/dev/null)"
    local cat_file
    cat_file=$(python3 -c "import sys; sys.path.insert(0, '$cat_dir'); from catalog import find_catalog_path; print(find_catalog_path() or '')" 2>/dev/null)
    if [ -n "$cat_file" ]; then
        ok "Catalogo: $cat_file"
    else
        err "models.json no encontrado"; fail=1
    fi

    if command -v ollama >/dev/null 2>&1; then
        ok "Ollama: $(ollama --version 2>/dev/null | head -1 | tr -d '\r')"
    else
        err "Ollama no instalado (bash install-ollama.sh)"; fail=1
    fi

    if server_running; then
        ok "Servidor Ollama: activo ($OLLAMA_HOST)"
        local n
        n=$(ollama list 2>/dev/null | tail -n +2 | wc -l)
        if [ "$n" -gt 0 ]; then
            ok "Modelos instalados: $n"
        else
            warn "No hay modelos instalados (randi pull)"
        fi
    else
        warn "Servidor Ollama: detenido (randi serve)"
    fi

    if [ "$PLATFORM" = "termux" ] && command -v pkg >/dev/null 2>&1; then
        if pkg list-installed 2>/dev/null | grep -q "ollama-backend-vulkan"; then
            ok "Backend Vulkan: instalado (GPU acelerada)"
        else
            warn "Backend Vulkan: no instalado (mas lento). pkg install ollama-backend-vulkan"
        fi
    fi

    if [ -r /proc/meminfo ]; then
        local mt ma
        mt=$(grep MemTotal /proc/meminfo | awk '{printf "%.1f", $2/1024/1024}')
        ma=$(grep MemAvailable /proc/meminfo | awk '{printf "%.1f", $2/1024/1024}')
        echo -e "  ${BLU}${B}RAM:${R} ${mt}GB total, ${ma}GB disponibles"
    fi

    echo ""
    if [ "$fail" = "1" ]; then
        err "Se encontraron problemas. Revisa: bash install-ollama.sh"
    else
        ok "Todo en orden."
    fi
}

show_menu() {
    while true; do
        clear
        echo ""
        echo -e "${BLU}${B}  ┌─────────────────────────────────────────┐${R}"
        echo -e "${BLU}${B}  │${R}  ${CYN}RANDI${R} — ${GRN}Local AI Terminal${R}           ${BLU}${B}│${R}"
        echo -e "${BLU}${B}  │${R}  Asistente IA multiplataforma          ${BLU}${B}│${R}"
        echo -e "${BLU}${B}  │${R}  por ${D}Sebastian Laguna${R}                  ${BLU}${B}│${R}"
        echo -e "${BLU}${B}  └─────────────────────────────────────────┘${R}"
        echo ""

        if server_running; then
            local loaded
            loaded=$(curl -sf "$OLLAMA_HOST/api/ps" 2>/dev/null | python3 -c "import json,sys; d=json.load(sys.stdin); print(len(d.get('models',[])))" 2>/dev/null || echo "0")
            echo -e "  ${GRN}●${R} Servidor activo    ${D}|${R}  ${GRN}Modelos cargados:${R} $loaded"
        else
            echo -e "  ${RED}●${R} Servidor detenido"
        fi
        echo ""
        echo -e "  ${B}1${R})  ${GRN}Chat TUI${R}       ${D}Interfaz interactiva${R}"
        echo -e "  ${B}2${R})  ${CYN}Run modelo${R}     ${D}Ejecuta modelo directo${R}"
        echo -e "  ${B}3${R})  ${YLW}Descargar${R}      ${D}Descargar modelo(s)${R}"
        echo -e "  ${B}4${R})  ${D}Listar${R}          ${D}Modelos instalados${R}"
        echo -e "  ${B}5${R})  ${D}Estado${R}          ${D}Servidor y recursos${R}"
        echo -e "  ${B}6${R})  ${CYN}Servidor${R}       ${D}Iniciar/Detener${R}"
        echo -e "  ${B}7${R})  ${CYN}Web UI${R}         ${D}Interfaz web local${R}"
        echo -e "  ${B}8${R})  ${D}Catalogo${R}        ${D}Modelos recomendados${R}"
        echo -e "  ${B}9${R})  ${D}Configuracion${R}   ${D}Ver configuracion${R}"
        echo -e "  ${B}10${R}) ${YLW}Actualizar${R}     ${D}Update desde GitHub o local${R}"
        echo -e "  ${B}11${R}) ${RED}Desinstalar${R}   ${D}Eliminar RANDI por completo${R}"
        echo -e "  ${B}12${R}) ${CYN}Imagen${R}        ${D}Generar imagen (A1111, GPU)${R}"
        echo -e "  ${B}13${R}) ${D}Doctor${R}         ${D}Diagnostico del sistema${R}"
        echo -e "  ${B}14${R}) ${CYN}Setup${R}         ${D}Onboarding: mejores modelos para tu equipo${R}"
        echo -e "  ${B}15${R}) ${CYN}Instalar${R}      ${D}Descargar y configurar un modelo${R}"
        echo -e "  ${B}0${R})  ${RED}Salir${R}"
        echo ""
        echo -ne "  ${BLU}${B}❯${R} "
        read -r opt
        case "$opt" in
            1) cmd_chat ;;
            2) cmd_run ;;
            3) cmd_pull ;;
            4) cmd_list ; echo ""; dim "Presiona Enter para continuar..."; read -r ;;
            5) cmd_status ; echo ""; dim "Presiona Enter para continuar..."; read -r ;;
            6)
                if server_running; then
                    cmd_stop
                else
                    cmd_serve
                fi
                echo ""; dim "Presiona Enter para continuar..."; read -r ;;
            7) cmd_web ; echo ""; dim "Presiona Enter para continuar..."; read -r ;;
            8) cmd_models ; echo ""; dim "Presiona Enter para continuar..."; read -r ;;
            9) cmd_config ; echo ""; dim "Presiona Enter para continuar..."; read -r ;;
            10) cmd_update ; echo ""; dim "Presiona Enter para continuar..."; read -r ;;
            11) cmd_uninstall ; echo ""; dim "Presiona Enter para continuar..."; read -r ;;
            12)
                echo ""
                echo -n "  Descripcion de la imagen: "
                read -r img_prompt
                cmd_img "$img_prompt"
                echo ""; dim "Presiona Enter para continuar..."; read -r ;;
            13) cmd_doctor ; echo ""; dim "Presiona Enter para continuar..."; read -r ;;
            14) cmd_setup ; echo ""; dim "Presiona Enter para continuar..."; read -r ;;
            15)
                echo ""
                echo -n "  Modelo a instalar: "
                read -r install_model_name
                cmd_install "$install_model_name"
                echo ""; dim "Presiona Enter para continuar..."; read -r ;;
            0) echo -e "${GRN}Hasta luego!${R}"; exit 0 ;;
            *) err "Opcion invalida"; sleep 1 ;;
        esac
    done
}

find_py_lib() {
    local name="$1"
    local candidates=(
        "$(cd "$(dirname "$0")" 2>/dev/null && pwd)/lib/$name"
        "$REPO_DIR/lib/$name"
        "$RANDI_DIR/lib/$name"
        "$HOME/.local/share/randi/lib/$name"
        "$PWD/lib/$name"
    )
    for c in "${candidates[@]}"; do
        if [ -f "$c" ]; then
            echo "$c"
            return 0
        fi
    done
    return 1
}

# ── Deteccion y recomendacion (motor compat) ────────────────────────────

_py_compat() {
    local script
    script=$(find_py_lib "$1") || {
        err "No se encuentra $1 (reinstala RANDI)"
        return 1
    }
    shift
    PYTHONPATH="$(dirname "$script")" python3 "$script" "$@"
}

cmd_hardware() {
    echo ""
    title "Deteccion de hardware"
    _py_compat hardware.py detect || {
        PYTHONPATH="$(find_py_lib . && echo "$(dirname "$(find_py_lib hardware.py)")")" python3 -c "
import sys; sys.path.insert(0, sys.argv[1])
import hardware
import json
print(json.dumps(hardware.to_dict(hardware.detect_hardware()), ensure_ascii=False, indent=2))
" "$(dirname "$(find_py_lib hardware.py)")"
    }
}

cmd_recommend() {
    local use_case=""
    local limit=5
    while [ $# -gt 0 ]; do
        case "$1" in
            --use-case) use_case="$2"; shift 2 ;;
            --limit) limit="$2"; shift 2 ;;
            *) use_case="${use_case:-$1}"; shift ;;
        esac
    done
    local lib_dir
    lib_dir=$(dirname "$(find_py_lib hardware.py)") || { err "Modulo no encontrado"; return 1; }
    echo ""
    title "Recomendacion de modelos${use_case:+ — ${use_case}}"
    PYTHONPATH="$lib_dir" python3 -c "
import sys; sys.path.insert(0, sys.argv[1])
import hardware, recommend
hw = hardware.detect_hardware()
use_case = sys.argv[2] or None
limit = int(sys.argv[3])
recs = recommend.rank_models(recommend.get_models(), hw, use_case=use_case, limit=limit)
from compat import GRADES
if not recs:
    print('  No hay modelos compatibles con tu hardware' + (' para '+use_case if use_case else '') + '.')
for r in recs:
    m, ev = r['model'], r['evaluation']
    g = GRADES.get(ev.grade, {}).get('color','')
    print(f'  [{ev.grade}] {m[\"id\"]:<24} {ev.status:<12} quant={ev.quant or \"-\"} tok/s={ev.toks_per_sec or \"-\"} grade={ev.score}')
" "$lib_dir" "$use_case" "$limit"
    echo ""
    dim "  Usa 'randi recommend --use-case code' para filtrar. Instala con 'randi pull <modelo>'."
}

cmd_tier() {
    local lib_dir
    lib_dir=$(dirname "$(find_py_lib hardware.py)") || { err "Modulo no encontrado"; return 1; }
    echo ""
    title "Tier list — modelos para tu hardware"
    PYTHONPATH="$lib_dir" python3 -c "
import sys; sys.path.insert(0, sys.argv[1])
import hardware, recommend
from compat import GRADES
hw = hardware.detect_hardware()
tiers = recommend.tier_list(recommend.get_models(), hw)
for grade in 'SABCDEF?':
    items = tiers.get(grade, [])
    if not items:
        continue
    color = GRADES.get(grade, {}).get('color', '')
    print(f'  ─ [{grade}] {GRADES.get(grade,{}).get(\"label\",\"\")}' )
    for it in items:
        print(f'       {it[\"model\"][\"id\"]}')
" "$lib_dir"
}

cmd_compare() {
    if [ $# -lt 2 ]; then
        echo "Uso: randi compare <modeloA> <modeloB>"
        return 1
    fi
    local lib_dir
    lib_dir=$(dirname "$(find_py_lib hardware.py)") || { err "Modulo no encontrado"; return 1; }
    echo ""
    title "Comparacion: $1 vs $2"
    PYTHONPATH="$lib_dir" python3 -c "
import sys; sys.path.insert(0, sys.argv[1])
import hardware, recommend
from compat import GRADES, evaluate_model_best
hw = hardware.detect_hardware()
models = recommend.get_models()
ids = set(m['id'] for m in models)
for target in (sys.argv[2], sys.argv[3]):
    model = next((m for m in models if m['id'] == target), None)
    if not model:
        print(f'  Modelo no encontrado: {target}')
        continue
    ev = evaluate_model_best(model, hw)
    print(f'  {model[\"id\"]:<26} [{ev.grade}] {ev.status:<12} quant={ev.quant} tok/s={ev.toks_per_sec} score={ev.score}')
" "$lib_dir" "$1" "$2"
}

cmd_requirements() {
    local lib_dir
    lib_dir=$(dirname "$(find_py_lib install.py)") || { err "Modulo no encontrado"; return 1; }
    _py_compat install.py requirements "$1"
}

cmd_ensure() {
    local lib_dir
    lib_dir=$(dirname "$(find_py_lib install.py)") || { err "Modulo no encontrado"; return 1; }
    _py_compat install.py ensure
}

cmd_install() {
    local lib_dir
    lib_dir=$(dirname "$(find_py_lib install.py)") || { err "Modulo no encontrado"; return 1; }
    _py_compat install.py install "$1"
}

cmd_setup() {
    local lib_dir
    lib_dir=$(dirname "$(find_py_lib install.py)") || { err "Modulo no encontrado"; return 1; }
    _py_compat install.py setup
}

