        echo -e "  ${B}randi ensure${R}              ${D}Verifica/instala deps nativas (winget en Windows)${R}"
        ;;
    *)
        if [ -n "${1:-}" ]; then
            cmd_run "$*"
        else
            show_menu
        fi
        ;;
esac
